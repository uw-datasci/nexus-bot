# Route the @uw-datasci scope (Raft) to GitHub Packages. Auth is NOT configured here: add
#   //npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
# to your user-level ~/.npmrc, with NODE_AUTH_TOKEN a classic PAT with read:packages.
# CI gets credentials from actions/setup-node; Vercel from apps/http/vercel.json.
@uw-datasci:registry=https://npm.pkg.github.com
