# Copy to .env.local (gitignored) for local development. Use your personal Discord test app and a
# dev database, never production values. In production these come from Infisical / Vercel.

# Discord Developer Portal → your app → General Information / Bot
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Postgres with the bot's `discord` schema. Locally, e.g. a Docker Postgres:
#   postgres://postgres:postgres@localhost:5432/postgres
# On Vercel, the Supabase transaction pooler URL for the nexus_bot role.
DATABASE_URL=

# /event-create's extraction: a key from the bot's Claude Console workspace (its monthly spend
# limit is the hard budget ceiling).
ANTHROPIC_API_KEY=

# The website admin app's internal API, for creating draft events. Locally, a preview deployment
# or `pnpm dev:admin` in uwdsc-website-v3 (http://localhost:3001). The token must match admin's.
ADMIN_INTERNAL_URL=
NEXUS_BOT_INTERNAL_TOKEN=
# Only for a preview deployment behind Vercel Deployment Protection: its bypass secret.
ADMIN_BYPASS_TOKEN=

# /feedback (Feedback loop). Its own Claude Console workspace key, separate from ANTHROPIC_API_KEY.
FEEDBACK_ANTHROPIC_API_KEY=
# The nexus-feedback GitHub App (same names as in Infisical /nexus-feedback). The private key is
# the PEM; escaped newlines (\n) are fine.
FEEDBACK_APP_ID=
FEEDBACK_APP_PRIVATE_KEY=
# A public Vercel Blob store, for screenshots copied into feedback issues.
BLOB_READ_WRITE_TOKEN=

# Errors: printed to the console unless NODE_ENV=production, then written to the shared Raft DB.
RAFT_APP_NAME=nexus-bot
RAFT_DATABASE_URL=

# Only for `pnpm test`: a throwaway database the db tests may wipe. Unset = db tests are skipped.
TEST_DATABASE_URL=
