# Copy to .env.local (gitignored) for local development. Use your personal Discord test app and a
# dev database, never production values. In production these come from Infisical / Vercel.

# Discord Developer Portal → your app → General Information / Bot
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Postgres with the bot's `discord` schema. Locally, e.g. a Docker Postgres:
#   postgres://postgres:postgres@localhost:5432/postgres
# On Vercel, the Supabase transaction pooler URL for the nexus_bot role.
DATABASE_URL=

# Errors: printed to the console unless NODE_ENV=production, then written to the shared Raft DB.
RAFT_APP_NAME=nexus-bot
RAFT_DATABASE_URL=

# Only for `pnpm test`: a throwaway database the db tests may wipe. Unset = db tests are skipped.
TEST_DATABASE_URL=
